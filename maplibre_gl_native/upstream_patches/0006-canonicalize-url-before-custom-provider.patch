  private:
+  // Mirror of the per-kind URL normalization in OnlineFileSource::request,
+  // applied before provider dispatch so a provider sees the same canonical URL
+  // the built-in client would have fetched.
+  [[nodiscard]] auto canonical_resource(const mbgl::Resource& resource) const
+    -> mbgl::Resource {
+    auto result = resource;
+    const auto options = resource_options_.tileServerOptions();
+    const auto apiKey = resource_options_.apiKey();
+    switch (resource.kind) {
+      case mbgl::Resource::Kind::Unknown:
+      case mbgl::Resource::Kind::Image:
+        break;
+      case mbgl::Resource::Kind::Style:
+        result.url =
+          mbgl::util::mapbox::normalizeStyleURL(options, resource.url, apiKey);
+        break;
+      case mbgl::Resource::Kind::Source:
+        result.url = mbgl::util::mapbox::normalizeSourceURL(
+          options, resource.url, apiKey
+        );
+        break;
+      case mbgl::Resource::Kind::Glyphs:
+        result.url = mbgl::util::mapbox::normalizeGlyphsURL(
+          options, resource.url, apiKey
+        );
+        break;
+      case mbgl::Resource::Kind::SpriteImage:
+      case mbgl::Resource::Kind::SpriteJSON:
+        result.url = mbgl::util::mapbox::normalizeSpriteURL(
+          options, resource.url, apiKey
+        );
+        break;
+      case mbgl::Resource::Kind::Tile:
+        result.url =
+          mbgl::util::mapbox::normalizeTileURL(options, resource.url, apiKey);
+        break;
+    }
+    return result;
+  }
