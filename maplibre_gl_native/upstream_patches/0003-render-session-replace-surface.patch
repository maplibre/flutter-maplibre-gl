+      }
+      backend.getDevice()->waitIdle(backend.getDispatcher());
+      swapchainFramebuffers.clear();
+      renderPass.reset();
+      swapchainImageViews.clear();
+      swapchainImages.clear();
+      acquireSemaphores.clear();
