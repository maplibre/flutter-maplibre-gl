+    // Drops every object bound to the current native surface, swapchain
+    // included, so the host may destroy the borrowed VkSurfaceKHR afterwards
+    // (Vulkan requires the swapchain to be destroyed before its surface).
+    // Device-level resources are untouched.
+    void releaseSurface() {
+      if (!surface && !swapchain) {
+        borrowed_surface = nullptr;
