+// Surface replacement keeps the renderer, and therefore every GPU-side
+// resource, alive across native surface recreation. See render_session.h for
+// the contract.
+auto render_session_release_surface(mln_render_session* session)
+  -> mln_status {
+  const auto status = validate_live_attached_render_session(session);
+  if (status != MLN_STATUS_OK) {
+    return status;
+  }
+  if (
+    session->kind != RenderSessionKind::Surface ||
+    !session->surface.backend->supports_surface_replace()
+  ) {
+    set_thread_error("surface replacement is not supported by this session");
+    return MLN_STATUS_UNSUPPORTED;
+  }
+  if (session->surface_released) {
+    return MLN_STATUS_OK;
+  }
+  try {
+    session->surface.backend->release_surface();
+  } catch (const std::exception& exception) {
+    set_native_stage_error("releasing render surface", exception);
+    return MLN_STATUS_NATIVE_ERROR;
+  }
+  session->surface_released = true;
+  return MLN_STATUS_OK;
+}
+
+auto render_session_replace_surface(
+  mln_render_session* session, void* surface, uint32_t width, uint32_t height,
+  double scale_factor
+) -> mln_status {
+  const auto status = validate_live_attached_render_session(session);
+  if (status != MLN_STATUS_OK) {
+    return status;
+  }
+  if (
+    session->kind != RenderSessionKind::Surface ||
+    !session->surface.backend->supports_surface_replace()
+  ) {
+    set_thread_error("surface replacement is not supported by this session");
+    return MLN_STATUS_UNSUPPORTED;
+  }
+  if (surface == nullptr) {
+    set_thread_error("replacement surface must not be null");
+    return MLN_STATUS_INVALID_ARGUMENT;
+  }
+  const auto dimensions_status = validate_dimensions(
+    width, height, scale_factor,
+    "surface dimensions and scale_factor must be positive"
+  );
+  if (dimensions_status != MLN_STATUS_OK) {
+    return dimensions_status;
+  }
+  const auto physical_status = validate_physical_size(
+    width, height, scale_factor, "scaled surface dimensions are too large"
+  );
+  if (physical_status != MLN_STATUS_OK) {
+    return physical_status;
+  }
+
+  const auto physical_width = physical_dimension(width, scale_factor);
+  const auto physical_height = physical_dimension(height, scale_factor);
+  try {
+    session->surface.backend->replace_surface(
+      surface, physical_width, physical_height
+    );
+  } catch (const std::exception& exception) {
+    set_native_stage_error("replacing render surface", exception);
+    return MLN_STATUS_NATIVE_ERROR;
+  }
+  if (auto* native_map = map_native(session->map); native_map != nullptr) {
+    native_map->setSize(mbgl::Size{width, height});
+  }
+  // The renderer bakes the pixel ratio in at construction; only a scale
+  // change forces a rebuild. Keeping it alive preserves uploaded tile
+  // textures, glyph atlases, and symbol placement across the swap.
+  if (session->scale_factor != scale_factor) {
+    session->renderer.reset();
+  }
+  session->width = width;
+  session->height = height;
+  session->physical_width = physical_width;
+  session->physical_height = physical_height;
+  session->scale_factor = scale_factor;
+  session->surface_released = false;
+  session->rendered_generation = 0;
+  ++session->generation;
+  return MLN_STATUS_OK;
+}
