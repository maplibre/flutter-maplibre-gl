+    // the renderer created against the old pass stays valid (the core relies
+    // on the same property in SurfaceRenderableResource::recreateSwapchain).
+    void adoptSurface(VkSurfaceKHR new_surface, mbgl::Size size) {
+      releaseSurface();
+      borrowed_surface = new_surface;
