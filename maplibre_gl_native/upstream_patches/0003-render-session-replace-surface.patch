+/**
+ * Releases the native surface of an attached surface render session without
+ * destroying the session.
+ *
+ * Destroys presentation objects bound to the current native surface (the
+ * Vulkan swapchain and related resources) while keeping the renderer and its
+ * GPU resources alive. After this call the host may destroy the native
+ * surface handle it lent to the session. The session is suspended: render and
+ * resize return MLN_STATUS_INVALID_STATE until a new surface is provided via
+ * mln_render_session_replace_surface. Releasing an already released surface
+ * is a no-op. Detach and destroy remain valid on a suspended session.
+ *
+ * This is the surface-recreation path embedders need when the window system
+ * recreates the native surface (for example Android device rotation), where a
+ * full detach/attach would discard every GPU-side resource and visibly
+ * re-render the map from scratch.
+ *
+ * Returns:
+ * - MLN_STATUS_OK on success.
+ * - MLN_STATUS_INVALID_ARGUMENT when session is null or not live.
+ * - MLN_STATUS_INVALID_STATE when the session is detached.
+ * - MLN_STATUS_UNSUPPORTED when the session is not a surface session or the
+ *   backend does not support surface replacement.
+ * - MLN_STATUS_WRONG_THREAD when called from a thread other than the session
+ *   owner thread.
+ * - MLN_STATUS_NATIVE_ERROR when an internal exception is converted to status.
+ */
+MLN_API mln_status mln_render_session_release_surface(
+  mln_render_session* session
+) MLN_NOEXCEPT;
+
+/**
+ * Points an attached surface render session at a new native surface, keeping
+ * the renderer and its GPU resources.
+ *
+ * The surface handle must be of the same backend kind the session was
+ * attached with (VkSurfaceKHR for Vulkan, EGLSurface/HDC for OpenGL) and must
+ * remain valid until it is released or replaced or the session is destroyed.
+ * Width and height are logical map dimensions, as in
+ * mln_render_session_resize. Calling this on a session whose surface was not
+ * released first is valid: the current surface is released before the new one
+ * is adopted.
+ *
+ * Returns:
+ * - MLN_STATUS_OK on success.
+ * - MLN_STATUS_INVALID_ARGUMENT when session is null or not live, surface is
+ *   null, dimensions are zero, scale_factor is non-positive or non-finite, or
+ *   scaled dimensions are too large.
+ * - MLN_STATUS_INVALID_STATE when the session is detached.
+ * - MLN_STATUS_UNSUPPORTED when the session is not a surface session or the
+ *   backend does not support surface replacement.
+ * - MLN_STATUS_WRONG_THREAD when called from a thread other than the session
+ *   owner thread.
+ * - MLN_STATUS_NATIVE_ERROR when an internal exception is converted to status.
+ */
+MLN_API mln_status mln_render_session_replace_surface(
+  mln_render_session* session, void* surface, uint32_t width, uint32_t height,
+  double scale_factor
+) MLN_NOEXCEPT;
