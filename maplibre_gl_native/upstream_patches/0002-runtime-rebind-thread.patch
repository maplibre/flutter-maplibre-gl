+// LOCAL SPIKE PATCH (flutter-maplibre-gl): see mln_runtime_rebind_thread in
+// runtime.h. This handles the runtime itself; maps and render sessions are
+// re-homed by their own modules from the C API wrapper.
+auto rebind_runtime_thread(mln_runtime* runtime) -> mln_status {
+  if (runtime == nullptr) {
+    set_thread_error("runtime must not be null");
+    return MLN_STATUS_INVALID_ARGUMENT;
+  }
+  const auto new_thread = std::this_thread::get_id();
+  {
+    const std::scoped_lock lock(runtime_registry_mutex());
+    const auto found = runtime_registry().find(runtime);
+    if (found == runtime_registry().end()) {
+      set_thread_error("runtime is not a live handle");
+      return MLN_STATUS_INVALID_ARGUMENT;
+    }
+    if (found->second->owner_thread == new_thread) {
+      return MLN_STATUS_OK;
+    }
+    if (
+      std::any_of(
+        runtime_registry().begin(), runtime_registry().end(),
+        [&](const auto& entry) -> bool {
+          return entry.second.get() != runtime &&
+                 entry.second->owner_thread == new_thread;
+        }
+      )
+    ) {
+      set_thread_error("calling thread already owns another live runtime");
+      return MLN_STATUS_INVALID_STATE;
+    }
+    found->second->owner_thread = new_thread;
+  }
+  // Re-register the runtime's RunLoop as the calling thread's scheduler; the
+  // previous thread's thread-local slot goes stale but is never consulted
+  // again unless a new runtime is created there (rejected by the check in
+  // create_runtime, acceptable under the single-runtime assumption).
+  mbgl::Scheduler::SetCurrent(runtime->run_loop.get());
+  return MLN_STATUS_OK;
+}
