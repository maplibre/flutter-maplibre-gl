+auto rebind_render_session_to_thread(
+  mln_render_session session, std::thread::id thread
+) -> mln_status {
+  auto& table = handle_table<mln_render_session_object>();
+  const std::scoped_lock lock(table.mutex());
+  auto* live = table.resolve_locked(session);
+  if (live == nullptr) {
+    return MLN_STATUS_INVALID_ARGUMENT;
+  }
+  live->owner_thread = thread;
+  return MLN_STATUS_OK;
+}
