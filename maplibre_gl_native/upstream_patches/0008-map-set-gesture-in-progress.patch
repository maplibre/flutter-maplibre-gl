+/**
+ * Marks a live touch gesture as feeding camera writes (platform SDK parity:
+ * gesture handlers set it on touch down and clear it on touch up).
+ *
+ * Returns:
+ * - MLN_STATUS_OK on success.
+ * - MLN_STATUS_INVALID_ARGUMENT when map is null or not live.
+ * - MLN_STATUS_WRONG_THREAD when called from a thread other than the map owner
+ *   thread.
+ * - MLN_STATUS_NATIVE_ERROR when an internal exception is converted to status.
+ */
+MLN_API mln_status
+mln_map_set_gesture_in_progress(mln_map* map, bool in_progress) MLN_NOEXCEPT;
