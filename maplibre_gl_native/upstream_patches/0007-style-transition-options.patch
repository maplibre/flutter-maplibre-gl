+// Transitions are converted to mbgl::Duration, which counts nanoseconds in an
+// int64. Past the value it can hold the conversion is undefined rather than
+// merely absurd, and since the style spec sets no upper bound of its own that
+// is the only limit worth imposing (it works out to about 292 years).
+constexpr double kMaxTransitionMs = static_cast<double>(
+  std::chrono::duration_cast<std::chrono::milliseconds>(mbgl::Duration::max())
+    .count()
+);
+
+auto validate_transition_option(double milliseconds, const char* name)
+  -> mln_status {
+  if (!std::isfinite(milliseconds) || milliseconds > kMaxTransitionMs) {
+    auto message = std::string{name} + " must be finite and at most " +
+                   std::to_string(static_cast<int64_t>(kMaxTransitionMs)) +
+                   ", or negative to leave it unset";
+    mln::core::set_thread_error(message.c_str());
+    return MLN_STATUS_INVALID_ARGUMENT;
+  }
+  return MLN_STATUS_OK;
+}
