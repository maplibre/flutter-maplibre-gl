+auto map_set_style_transition_options(
+  mln_map* map, double duration_ms, double delay_ms,
+  bool enable_placement_transitions
+) -> mln_status {
+  const auto status = validate_map(map);
+  if (status != MLN_STATUS_OK) {
+    return status;
+  }
+  const auto duration_status =
+    validate_transition_option(duration_ms, "duration_ms");
+  if (duration_status != MLN_STATUS_OK) {
+    return duration_status;
+  }
+  const auto delay_status = validate_transition_option(delay_ms, "delay_ms");
+  if (delay_status != MLN_STATUS_OK) {
+    return delay_status;
+  }
+  auto options = mbgl::style::TransitionOptions{};
+  if (duration_ms >= 0) {
+    options.duration = std::chrono::duration_cast<mbgl::Duration>(
+      std::chrono::duration<double, std::milli>(duration_ms)
+    );
+  }
+  if (delay_ms >= 0) {
+    options.delay = std::chrono::duration_cast<mbgl::Duration>(
+      std::chrono::duration<double, std::milli>(delay_ms)
+    );
+  }
+  options.enablePlacementTransitions = enable_placement_transitions;
+  map->map->getStyle().setTransitionOptions(options);
+  return MLN_STATUS_OK;
+}
