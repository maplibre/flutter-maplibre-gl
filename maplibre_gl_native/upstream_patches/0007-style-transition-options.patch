+/**
+ * Sets the style transition options.
+ *
+ * duration_ms and delay_ms apply to style property transitions; a negative
+ * value leaves the corresponding option unset (style defaults), and a positive
+ * one must be finite and representable as a nanosecond duration, which caps it
+ * at 9223372036854 (about 292 years).
+ * enable_placement_transitions controls whether symbol placement changes
+ * cross-fade (the style default is true); disabling it makes symbol updates
+ * apply instantly, e.g. while dragging a symbol feature.
+ *
+ * This is a map command.
+ *
+ * Returns:
+ * - MLN_STATUS_OK on success.
+ * - MLN_STATUS_INVALID_ARGUMENT when map is null or not live, or when
+ *   duration_ms or delay_ms is non-finite or above 9223372036854.
+ * - MLN_STATUS_WRONG_THREAD when called from a thread other than the map owner
+ *   thread.
+ * - MLN_STATUS_NATIVE_ERROR when an internal exception is converted to status.
+ */
+MLN_API mln_status mln_map_set_style_transition_options(
+  mln_map* map, double duration_ms, double delay_ms,
+  bool enable_placement_transitions
+) MLN_NOEXCEPT;
+
