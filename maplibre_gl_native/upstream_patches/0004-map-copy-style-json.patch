+/**
+ * Copies the current style as a full style-spec JSON document into
+ * caller-owned memory.
+ *
+ * out_json may be null only when json_capacity is 0; calling with a zero
+ * capacity queries the required size without copying. On success,
+ * *out_json_size receives the byte length of the style JSON, excluding any
+ * null terminator.
+ *
+ * Returns:
+ * - MLN_STATUS_OK on success (including the zero-capacity size query).
+ * - MLN_STATUS_INVALID_ARGUMENT when map is null or not live, out_json is
+ *   null with non-zero capacity, json_capacity is non-zero but too small, or
+ *   out_json_size is null.
+ * - MLN_STATUS_WRONG_THREAD when called from a thread other than the map owner
+ *   thread.
+ * - MLN_STATUS_NATIVE_ERROR when an internal exception is converted to status.
+ */
+MLN_API mln_status mln_map_copy_style_json(
+  mln_map* map, char* out_json, size_t json_capacity, size_t* out_json_size
+) MLN_NOEXCEPT;
+
 #ifdef __cplusplus
 }
 #endif
