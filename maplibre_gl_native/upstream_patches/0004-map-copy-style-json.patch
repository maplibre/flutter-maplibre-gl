index 42ea3776..34aff01e 100644
--- a/src/map/map.cpp
+++ b/src/map/map.cpp
@@ -2901,6 +2901,37 @@ auto map_set_style_json(mln_map* map, const char* json) -> mln_status {
   return MLN_STATUS_OK;
 }
 
+auto map_copy_style_json(
+  mln_map* map, char* out_json, size_t json_capacity, size_t* out_json_size
+) -> mln_status {
+  const auto status = validate_map(map);
+  if (status != MLN_STATUS_OK) {
+    return status;
+  }
+  if (out_json == nullptr && json_capacity > 0) {
+    set_thread_error("out_json must not be null when capacity is non-zero");
+    return MLN_STATUS_INVALID_ARGUMENT;
+  }
+  if (out_json_size == nullptr) {
+    set_thread_error("out_json_size must not be null");
+    return MLN_STATUS_INVALID_ARGUMENT;
+  }
+
+  const auto json = map->map->getStyle().getJSON();
+  *out_json_size = json.size();
+  if (json_capacity == 0) {
+    return MLN_STATUS_OK;
+  }
+  if (json_capacity < json.size()) {
+    set_thread_error("json_capacity is too small");
+    return MLN_STATUS_INVALID_ARGUMENT;
+  }
+  if (!json.empty()) {
+    std::copy(json.begin(), json.end(), out_json);
+  }
+  return MLN_STATUS_OK;
+}
